<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.book.mapper.BorrowRecordMapper">
    
    <resultMap type="BorrowRecord" id="BorrowRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="borrowTime"    column="borrow_time"    />
        <result property="planReturnTime"    column="plan_return_time"    />
        <result property="returnTime"    column="return_time"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <resultMap id="BorrowRecordBorrowItemResult" type="BorrowRecord" extends="BorrowRecordResult">
        <collection property="borrowItemList" ofType="BorrowItem" column="record_id" select="selectBorrowItemList" />
    </resultMap>

    <resultMap type="BorrowItem" id="BorrowItemResult">
        <result property="itemId"    column="item_id"    />
        <result property="recordId"    column="record_id"    />
        <result property="bookId"    column="book_id"    />
        <result property="bookName"    column="book_name"    />
    </resultMap>

    <sql id="selectBorrowRecordVo">
        select record_id, user_id, user_name, borrow_time, plan_return_time, return_time, status, create_time, update_time from borrow_record
    </sql>

    <select id="selectBorrowRecordList" parameterType="BorrowRecord" resultMap="BorrowRecordResult">
        <include refid="selectBorrowRecordVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="borrowTime != null "> and borrow_time = #{borrowTime}</if>
            <if test="planReturnTime != null "> and plan_return_time = #{planReturnTime}</if>
            <if test="returnTime != null "> and return_time = #{returnTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBorrowRecordByRecordId" parameterType="Long" resultMap="BorrowRecordBorrowItemResult">
        select record_id, user_id, user_name, borrow_time, plan_return_time, return_time, status, create_time, update_time
        from borrow_record
        where record_id = #{recordId}
    </select>

    <select id="selectBorrowItemList" resultMap="BorrowItemResult">
        select item_id, record_id, book_id, book_name
        from borrow_item
        where record_id = #{record_id}
    </select>

    <insert id="insertBorrowRecord" parameterType="BorrowRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into borrow_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="borrowTime != null">borrow_time,</if>
            <if test="planReturnTime != null">plan_return_time,</if>
            <if test="returnTime != null">return_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="borrowTime != null">#{borrowTime},</if>
            <if test="planReturnTime != null">#{planReturnTime},</if>
            <if test="returnTime != null">#{returnTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateBorrowRecord" parameterType="BorrowRecord">
        update borrow_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="borrowTime != null">borrow_time = #{borrowTime},</if>
            <if test="planReturnTime != null">plan_return_time = #{planReturnTime},</if>
            <if test="returnTime != null">return_time = #{returnTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteBorrowRecordByRecordId" parameterType="Long">
        delete from borrow_record where record_id = #{recordId}
    </delete>

    <delete id="deleteBorrowRecordByRecordIds" parameterType="String">
        delete from borrow_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
    
    <delete id="deleteBorrowItemByRecordIds" parameterType="String">
        delete from borrow_item where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>

    <delete id="deleteBorrowItemByRecordId" parameterType="Long">
        delete from borrow_item where record_id = #{recordId}
    </delete>

    <insert id="batchBorrowItem">
        insert into borrow_item( item_id, record_id, book_id, book_name) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.itemId}, #{item.recordId}, #{item.bookId}, #{item.bookName})
        </foreach>
    </insert>
</mapper>